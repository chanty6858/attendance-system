# Copy to .env and fill in for production.
# QR_SECRET signs every guest QR code — change this before generating badges.
QR_SECRET=change-me-to-a-long-random-string

# Optional: protects /api/admin/* (import, slots, stations, staff, badges).
ADMIN_TOKEN=

# Where the SQLite file lives.
DB_PATH=./data/event.db

PORT=8080
HOST=0.0.0.0
